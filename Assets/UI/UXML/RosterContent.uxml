<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElementsSchema.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MapPhaseStyle.uss?fileID=7433441132597879392&amp;guid=cfc4ea522fdc98e4f910a39abcf0944e&amp;type=3#MapPhaseStyle"/>

    <!--
      Roster tab content only. The old MapPhase.uxml header (CLAN WARBAND
      title + countdown timer) and bottom nav both moved up to
      PhaseShell.uxml - the header because it's now the shared stats ledger
      (no timer, see PhaseShell.uxml), the nav because it's shared chrome.

      The reveal/level-up/draft overlays ALSO moved to the shell root rather
      than living in here, so they still cover the whole screen edge-to-edge
      (header + footer included) rather than just this content pane.
      PlanningPhaseController is handed the shell's entire rootVisualElement
      in Initialize(), so its existing Q<>("reveal-overlay") etc. calls keep
      working unchanged - only where those elements physically live changed.
    -->
    <ui:VisualElement name="roster-content" class="screen-content">

        <!-- Cards are instantiated from UnitCard.uxml by PlanningPhaseController -->
        <ui:ScrollView name="unit-list" class="unit-list"/>

        <ui:VisualElement class="action-container">
            <ui:Label name="selection-counter" text="0 / 5 SELECTED" class="selection-counter"/>
            <ui:Button text="MARCH TO WAR" name="btn-engage" class="engage-button">
                <ui:VisualElement picking-mode="Ignore" class="button-corner-accent button-corner-accent-tr"/>
                <ui:VisualElement picking-mode="Ignore" class="button-corner-accent button-corner-accent-bl"/>
            </ui:Button>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
