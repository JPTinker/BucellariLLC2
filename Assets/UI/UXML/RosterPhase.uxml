<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElementsSchema.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MapPhaseStyle.uss?fileID=7433441132597879392&amp;guid=cfc4ea522fdc98e4f910a39abcf0944e&amp;type=3#MapPhaseStyle"/>

    <!-- Unpadded outer root. screen-root (below) carries the padding; the overlays
         are siblings of screen-root here so their position:absolute inset:0 fills
         the WHOLE panel edge-to-edge, not just screen-root's padded content box. -->
    <ui:VisualElement name="phase-root" class="phase-root">

        <ui:VisualElement class="screen-root">
            <ui:VisualElement class="header-container">
                <ui:VisualElement class="header-titles">
                    <ui:Label text="CLAN WARBAND" class="header-title"/>
                    <ui:Label text="Pre-Combat Oath Assessment" class="header-subtitle"/>
                </ui:VisualElement>
                <ui:VisualElement class="timer-container">
                    <ui:Label text="APOCALYPSE APPROACHES" class="timer-label"/>
                    <ui:Label text="00:14:59" class="timer-value"/>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Cards are instantiated from UnitCard.uxml by PlanningPhaseController -->
            <ui:ScrollView name="unit-list" class="unit-list"/>

            <ui:VisualElement class="action-container">
                <ui:Label name="selection-counter" text="0 / 5 SELECTED" class="selection-counter"/>
                <ui:Button text="MARCH TO WAR" name="btn-engage" class="engage-button">
                    <ui:VisualElement picking-mode="Ignore" class="button-corner-accent button-corner-accent-tr"/>
                    <ui:VisualElement picking-mode="Ignore" class="button-corner-accent button-corner-accent-bl"/>
                </ui:Button>
            </ui:VisualElement>

            <!-- Bottom nav. Roster and Decision are both functional, switched by
                 PhaseTabSwitcher. Campaign Map (movement planning) and Inventory
                 (supplies) are visible but disabled stubs until those screens exist. -->
            <ui:VisualElement name="bottom-nav-bar" class="bottom-nav-bar">
                <ui:Button name="nav-roster" text="ROSTER" class="nav-button nav-button-active"/>
                <ui:Button name="nav-decision" text="DECISION" class="nav-button"/>
                <ui:Button name="nav-map" text="CAMPAIGN MAP" class="nav-button"/>
                <ui:Button name="nav-inventory" text="INVENTORY" class="nav-button"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- New-unit reveal overlay. Hidden by default; PlanningPhaseController shows/animates
             this for each unit in GameStateManager.Instance.PendingReveal. -->
        <ui:VisualElement name="reveal-overlay" class="reveal-overlay hidden">
            <ui:VisualElement name="reveal-flash" picking-mode="Ignore" class="reveal-flash"/>
            <ui:VisualElement name="reveal-card" class="reveal-card">
                <ui:Label text="NEW RECRUIT" class="reveal-eyebrow"/>
                <ui:VisualElement name="reveal-icon-frame" class="reveal-icon-frame">
                    <ui:VisualElement name="reveal-icon" class="reveal-icon"/>
                </ui:VisualElement>
                <ui:Label name="reveal-name" text="" class="reveal-name"/>
                <ui:Label text="Tap to continue" class="reveal-continue-hint"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Level-up overlay. Hidden by default; PlanningPhaseController shows/animates
             this for each entry in GameStateManager.Instance.PendingLevelUps. Reuses the
             same punch-in/flash fanfare as reveal-card, just with a before/after stat
             readout instead of a plain icon+name. -->
        <ui:VisualElement name="level-up-overlay" class="reveal-overlay hidden">
            <ui:VisualElement name="level-up-flash" picking-mode="Ignore" class="reveal-flash"/>
            <ui:VisualElement name="level-up-card" class="reveal-card">
                <ui:Label text="LEVEL UP!" class="reveal-eyebrow"/>
                <ui:VisualElement name="level-up-icon-frame" class="reveal-icon-frame">
                    <ui:VisualElement name="level-up-icon" class="reveal-icon"/>
                </ui:VisualElement>
                <ui:Label name="level-up-name" text="" class="reveal-name"/>
                <ui:Label name="level-up-level" text="" class="level-up-level"/>
                <ui:VisualElement class="level-up-stat-row">
                    <ui:Label name="level-up-hp-value" text="" class="level-up-stat-value"/>
                    <ui:Label name="level-up-atk-value" text="" class="level-up-stat-value"/>
                </ui:VisualElement>
                <ui:Label text="Tap to continue" class="reveal-continue-hint"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Draft overlay: "choose 1 of N" new recruits. Hidden by default;
             PlanningPhaseController populates draft-options from
             GameStateManager.Instance.PendingDraftOptions and shows this
             before the reveal overlay above. -->
        <ui:VisualElement name="draft-overlay" class="draft-overlay hidden">
            <ui:Label text="CHOOSE YOUR RECRUIT" class="reveal-eyebrow"/>
            <ui:VisualElement name="draft-options" class="draft-options-row"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
