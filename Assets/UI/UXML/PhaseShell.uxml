<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElementsSchema.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/MapPhaseStyle.uss?fileID=7433441132597879392&amp;guid=cfc4ea522fdc98e4f910a39abcf0944e&amp;type=3#MapPhaseStyle"/>
    <Style src="project://database/Assets/UI/USS/PhaseShell.uss?fileID=7433441132597879392&amp;guid=43ba64f2b8dc16f4f86eed5a0667948b&amp;type=3#PhaseShell"/>
    <ui:VisualElement name="phase-root" class="phase-root">
        <ui:VisualElement class="screen-root">
          <ui:VisualElement name="shell-sidebar" class="shell-sidebar">
            <ui:VisualElement name="stats-header" class="stats-header">
                <ui:VisualElement class="stats-header__row">
                    <ui:Label name="ledger-sync-status" text="[Escape Party Stable ]" class="label-caps text-primary-fixed-dim"/>
                    <ui:Button name="btn-save-game" tooltip="Save Game" class="save-button">
                        <ui:VisualElement picking-mode="Ignore" class="save-button__icon"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="stats-header__grid">
                    <ui:VisualElement tooltip="Population vs. Unit Capacity, built via Build a Ship." class="stats-header__cell">
                        <ui:Label text="Units" class="label-caps text-muted"/>
                        <ui:VisualElement class="row row--baseline">
                            <ui:Label name="res-units-val" text="18" class="stat-value text-primary"/>
                            <ui:Label name="res-units-cap" text="/24" class="stat-suffix"/>
                        </ui:VisualElement>
                        <ui:Label name="res-units-delta" text="6 IDLE" class="label-caps text-primary-fixed"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="stats-header__cell">
                        <ui:Label text="Food" class="label-caps text-muted"/>
                        <ui:Label name="res-food-val" text="340" class="stat-value"/>
                        <ui:Label name="res-food-delta" text="+28" class="label-caps text-bold text-positive"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="stats-header__cell">
                        <ui:Label text="Scrap" class="label-caps text-muted"/>
                        <ui:Label name="res-materials-val" text="185" class="stat-value"/>
                        <ui:Label name="res-materials-delta" text="-20" class="label-caps text-bold text-negative"/>
                    </ui:VisualElement>
                    <ui:VisualElement tooltip="Villagers sent to labor directives this cycle. Idle villagers roll over to next cycle." class="stats-header__cell">
                        <ui:Label text="Villagers" class="label-caps text-muted"/>
                        <ui:VisualElement class="row row--baseline">
                            <ui:Label name="res-villagers-val" text="5" class="stat-value text-primary-container"/>
                            <ui:Label name="res-villagers-cap" text="/10" class="stat-suffix"/>
                        </ui:VisualElement>
                        <ui:Label name="res-villagers-delta" text="5 IDLE" class="label-caps text-muted"/>
                    </ui:VisualElement>
                    <ui:VisualElement tooltip="-1% per Unit sent to battle, -3% per Villager sent to labor. +0.25% per kill and +5% per rescue, applied post-battle." class="stats-header__cell">
                        <ui:Label text="Morale" class="label-caps text-muted"/>
                        <ui:Label name="res-morale-val" text="84%" class="stat-value text-primary-fixed"/>
                        <ui:Label name="res-morale-delta" text="+5%" class="label-caps text-bold text-positive"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="action-container">
                <ui:VisualElement name="readiness-checklist" class="readiness-checklist">
                    <ui:Label text="READY TO MARCH" class="label-caps text-muted readiness-title"/>
                    <ui:Label name="check-course" text="Choose a course" class="readiness-row"/>
                    <ui:Label name="check-squad" text="Select your squad" class="readiness-row"/>
                    <ui:Label name="check-villagers" text="Assign all villagers" class="readiness-row"/>
                    <ui:Label name="check-budget" text="Cannot afford queued ship" class="readiness-row readiness-row--extra"/>
                </ui:VisualElement>
                <ui:Button text="MARCH TO WAR" name="btn-engage" class="engage-button">
                    <ui:VisualElement picking-mode="Ignore" class="button-corner-accent button-corner-accent-tr"/>
                    <ui:VisualElement picking-mode="Ignore" class="button-corner-accent button-corner-accent-bl"/>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="bottom-nav-bar" class="bottom-nav-bar">
                <ui:Button name="nav-plan" text="PLAN" class="nav-button nav-button-active"/>
                <ui:Button name="nav-store" text="STORE" class="nav-button"/>
            </ui:VisualElement>
          </ui:VisualElement>
          <ui:VisualElement name="content-slot" class="content-slot"/>
        </ui:VisualElement>
        <ui:VisualElement name="reveal-overlay" class="reveal-overlay hidden">
            <ui:VisualElement name="reveal-flash" picking-mode="Ignore" class="reveal-flash"/>
            <ui:VisualElement name="reveal-card" class="reveal-card">
                <ui:Label text="NEW RECRUIT" class="reveal-eyebrow"/>
                <ui:VisualElement name="reveal-icon-frame" class="reveal-icon-frame">
                    <ui:VisualElement name="reveal-icon" class="reveal-icon"/>
                </ui:VisualElement>
                <ui:Label name="reveal-name" text="" class="reveal-name"/>
                <ui:Label text="Tap to continue" class="reveal-continue-hint"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="level-up-overlay" class="reveal-overlay hidden">
            <ui:VisualElement name="level-up-flash" picking-mode="Ignore" class="reveal-flash"/>
            <ui:VisualElement name="level-up-card" class="reveal-card">
                <ui:Label text="LEVEL UP!" class="reveal-eyebrow"/>
                <ui:VisualElement name="level-up-icon-frame" class="reveal-icon-frame">
                    <ui:VisualElement name="level-up-icon" class="reveal-icon"/>
                </ui:VisualElement>
                <ui:Label name="level-up-name" text="" class="reveal-name"/>
                <ui:Label name="level-up-level" text="" class="level-up-level"/>
                <ui:VisualElement class="level-up-stat-row">
                    <ui:Label name="level-up-hp-value" text="" class="level-up-stat-value"/>
                    <ui:Label name="level-up-atk-value" text="" class="level-up-stat-value"/>
                </ui:VisualElement>
                <ui:Label text="Tap to continue" class="reveal-continue-hint"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="draft-overlay" class="draft-overlay hidden">
            <ui:Label text="CHOOSE A RECRUIT OR VILLAGER" class="reveal-eyebrow"/>
            <ui:VisualElement name="draft-options" class="draft-options-row"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
