<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/DecisionContent.uss?fileID=7433441132597879392&amp;guid=ba0e156fc08a3fa408c60ca9594c1642&amp;type=3#DecisionContent"/>
    <Style src="project://database/Assets/UI/USS/PhaseShell.uss?fileID=7433441132597879392&amp;guid=43ba64f2b8dc16f4f86eed5a0667948b&amp;type=3#PhaseShell"/>
    <Style src="project://database/Assets/UI/USS/DecisionTab.uss?fileID=7433441132597879392&amp;guid=ede1f172d358ab540beaa266fb7db425&amp;type=3#DecisionTab"/>
    <!--
      The single "Plan" screen (file keeps its DecisionContent name so the
      scene's template reference stays valid). Everything the player must
      decide before marching is here: course, directives, squad. The forecast
      lives in the sidebar ledger and the readiness checklist beside it.
    -->
    <ui:VisualElement name="decision-content" class="screen-content plan-root">
        <ui:VisualElement name="plan-strip" class="panel plan-strip">
            <ui:VisualElement class="row row--gap-sm">
                <ui:VisualElement class="pulse-dot"/>
                <ui:Label text="LAST CYCLE" class="label-caps text-muted"/>
                <ui:Label name="debrief-kills" text="0 Kills" class="stat-text"/>
                <ui:Label name="debrief-saved" text="0 Saved" class="stat-text"/>
                <ui:Label name="debrief-losses" text="0 Lost" class="stat-text"/>
                <ui:Label name="debrief-morale-total" text="+0% MORALE" class="label-caps text-bold text-positive"/>
            </ui:VisualElement>
            <ui:Label name="evacuation-status" text="" class="label-caps chip"/>
        </ui:VisualElement>

        <ui:VisualElement name="plan-columns" class="plan-columns">
            <ui:ScrollView name="plan-orders" mode="Vertical" class="plan-orders">
                <ui:Label text="COURSE" name="section-course" class="label-caps section-title plan-section-title"/>
                <ui:VisualElement name="course-options" class="course-options">
                    <ui:Button name="option-stay-put" tooltip="Hold position and work the site harder. x2 Food/Scrap from directives, no progress toward the evacuation zone." class="course-option">
                        <ui:Label text="STAY PUT" class="label-caps card-title"/>
                        <ui:Label text="x2 yields, no progress" class="body-text text-muted"/>
                    </ui:Button>
                    <ui:Button name="option-travel" tooltip="Keep the convoy moving. -1 cycle until the evacuation zone, standard yields." class="course-option">
                        <ui:Label text="TRAVEL" class="label-caps card-title"/>
                        <ui:Label text="-1 cycle to evac" class="body-text text-muted"/>
                    </ui:Button>
                    <ui:Button name="option-rest" tooltip="Break camp and tend to the wounded. Heals all units to full HP, no progress toward the evacuation zone." class="course-option">
                        <ui:Label text="REST" class="label-caps card-title"/>
                        <ui:Label text="Heal all units" class="body-text text-muted"/>
                    </ui:Button>
                </ui:VisualElement>

                <ui:Label text="LABOR" name="section-labor" class="label-caps section-title plan-section-title"/>
                <ui:VisualElement name="card-scavenge" tooltip="-10 Food per Villager, +10 Scrap per Villager." class="panel directive-row">
                    <ui:VisualElement class="directive-row__text">
                        <ui:Label text="Search for Materials" class="label-caps card-title"/>
                        <ui:Label text="-10 Food / +10 Scrap each" class="body-text text-muted"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="stepper">
                        <ui:Button name="btn-scavenge-dec" text="-" class="stepper__btn"/>
                        <ui:Label name="count-scavenge" text="0" class="stepper__value"/>
                        <ui:Button name="btn-scavenge-inc" text="+" class="stepper__btn"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="card-harvest" tooltip="-10 Food per Villager, +30 Food per Villager." class="panel directive-row">
                    <ui:VisualElement class="directive-row__text">
                        <ui:Label text="Hunt and Gather" class="label-caps card-title"/>
                        <ui:Label text="-10 Food / +30 Food each" class="body-text text-muted"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="stepper">
                        <ui:Button name="btn-harvest-dec" text="-" class="stepper__btn"/>
                        <ui:Label name="count-harvest" text="0" class="stepper__value"/>
                        <ui:Button name="btn-harvest-inc" text="+" class="stepper__btn"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="card-expansion" tooltip="-150 Scrap and -8 Villagers (crew) per ship. +5 Unit Cap, +10 Villager Cap." class="panel directive-row">
                    <ui:VisualElement class="directive-row__text">
                        <ui:Label text="Build a Ship" class="label-caps card-title"/>
                        <ui:Label text="-150 Scrap, -8 Villagers / +5 Unit Cap" class="body-text text-muted"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="stepper">
                        <ui:Button name="btn-expansion-dec" text="-" class="stepper__btn"/>
                        <ui:Label name="count-expansion" text="0" class="stepper__value"/>
                        <ui:Button name="btn-expansion-inc" text="+" class="stepper__btn"/>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Label name="plan-warning" text="" class="body-text plan-warning"/>

                <ui:VisualElement name="action-footer" class="action-footer">
                    <ui:Button name="btn-execute-cycle" text="Confirm Allocations &amp; Execute Cycle" class="btn btn--primary"/>
                    <ui:Button name="btn-reset" text="Reset Assignments" class="btn btn--ghost"/>
                </ui:VisualElement>
            </ui:ScrollView>

            <ui:VisualElement name="plan-squad" class="plan-squad">
                <ui:VisualElement class="row row--space-between plan-squad__header">
                    <ui:Label text="SQUAD" name="section-squad" class="label-caps section-title"/>
                    <ui:Label name="count-vanguard" text="0 Selected" class="label-caps tag tag--danger"/>
                </ui:VisualElement>
                <ui:VisualElement name="vanguard-roster" class="vanguard-roster"/>
                <ui:Label name="vanguard-empty-hint" text="Tap unit cards to pick your team." class="body-text text-muted vanguard-empty-hint"/>
                <!-- Cards are instantiated from UnitCard.uxml by PlanningPhaseController -->
                <ui:ScrollView name="unit-list" class="unit-list"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
