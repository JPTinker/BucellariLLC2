<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElementsSchema.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/CombatPhaseStyle.uss?fileID=7433441132597879392&amp;guid=0d4aa06d22099cf418dbb3a703ddd4d9&amp;type=3#CombatPhaseStyle"/>
    <ui:VisualElement name="combat-screen" class="combat-screen">
        <ui:VisualElement name="resource-bar" class="resource-bar">
            <ui:VisualElement class="resource-heading">
                <ui:Label text="BATTLEFIELD STATUS" class="eyebrow"/>
                <ui:Label text="THE OLD QUARRY" class="location-name"/>
            </ui:VisualElement>
            <ui:VisualElement class="resource-group">
                <ui:VisualElement class="resource-item">
                    <ui:Label text="TOWNSFOLK SAVED" class="resource-label"/>
                    <ui:Label name="townsfolk-saved-value" text="12 / 20" class="resource-value resource-value-positive"/>
                </ui:VisualElement>
                <ui:VisualElement class="resource-item">
                    <ui:Label text="WAR BAND" class="resource-label"/>
                    <ui:Label name="unit-count-value" text="3 UNITS" class="resource-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="resource-item">
                    <ui:Label text="GOLD" class="resource-label"/>
                    <ui:Label name="gold-value" text="100" class="resource-value resource-value-gold"/>
                </ui:VisualElement>
                <ui:VisualElement class="round-item">
                    <ui:Label text="ROUND" class="resource-label"/>
                    <ui:Label name="round-value" text="04" class="round-value"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="play-area">
            <ui:VisualElement name="unit-roster" class="unit-roster">
                <ui:VisualElement class="panel-heading">
                    <ui:Label text="YOUR UNITS" class="panel-title"/>
                    <ui:Label text="SELECT A UNIT" class="panel-hint"/>
                </ui:VisualElement>
                <ui:ScrollView name="unit-list" class="unit-list"/>
            </ui:VisualElement>
            <ui:VisualElement name="battlefield-panel" class="battlefield-panel"/>
        </ui:VisualElement>
        <ui:VisualElement name="action-bar" class="action-bar">
            <ui:VisualElement class="action-heading">
                <ui:Label text="AVAILABLE ACTIONS" class="panel-title"/>
                <ui:Label text="VANCE&apos;S TURN" class="turn-label"/>
            </ui:VisualElement>
            <ui:VisualElement class="action-buttons">
                <ui:Button name="action-fortify" text="FORTIFY" class="action-button"/>
                <ui:Button name="action-scout" text="SCOUT" class="action-button"/>
                <ui:Button name="action-spells" text="SPELLS" class="action-button action-button-spell"/>
                <ui:Button name="action-attack" text="ATTACK" class="action-button action-button-primary"/>
                <ui:Button name="action-move" text="MOVE" class="action-button"/>
                <ui:Button name="end-turn" text="END TURN" class="end-turn-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
