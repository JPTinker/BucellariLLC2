/* TitleScreen.uss
   Standalone - the title scene doesn't load PhaseShell.uss, so the color
   tokens it needs are redeclared here with the same values. */

.title-root {
    --color-surface: #1a2634;
    --color-surface-container: #243447;
    --color-surface-container-high: #2c4057;
    --color-primary: #e0fbff;
    --color-primary-fixed-dim: #00dbe7;
    --color-primary-container: #00F2FF;
    --color-on-primary: #00363A;
    --color-on-surface: #e0fbff;
    --color-on-surface-variant: #a9c4d0;
    --color-outline-variant: #35506a;

    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface);
    color: var(--color-on-surface);
}

/* Faint cyan glow at the center; sits behind the panel and ignores picking. */
.title-backdrop {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0, 242, 255, 0.04);
    border-width: 0;
}

.title-panel {
    width: 480px;
    max-width: 90%;
    align-items: stretch;
}

.title-eyebrow-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}
.title-eyebrow-line {
    width: 28px;
    height: 1px;
    background-color: var(--color-primary-fixed-dim);
    opacity: 0.7;
}
.title-eyebrow {
    font-size: 11px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--color-primary-fixed-dim);
    margin: 0 12px;
}

.title-heading {
    font-size: 56px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--color-primary);
    margin-top: 6px;
    margin-bottom: 8px;
    white-space: normal;
    text-shadow: 0 0 18px rgba(0, 242, 255, 0.45);
}

.title-divider {
    flex-direction: row;
    align-items: center;
    margin: 0 60px 36px 60px;
}
.title-divider__line { flex-grow: 1; height: 1px; background-color: var(--color-outline-variant); }
.title-divider__notch {
    width: 6px;
    height: 6px;
    margin: 0 8px;
    background-color: var(--color-primary-fixed-dim);
    rotate: 45deg;
}

.btn {
    height: 68px;
    border-radius: 3px;
    border-width: 0;
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin: 0 0 14px 0;
    padding: 0 20px;
}
.btn__row {
    flex-direction: row;
    flex-grow: 1;
    align-items: center;
    justify-content: space-between;
}
.btn__label { font-size: 18px; letter-spacing: 2px; -unity-font-style: bold; }
.btn__detail { font-size: 11px; letter-spacing: 1px; -unity-font-style: bold; opacity: 0.8; }
.btn--primary { background-color: var(--color-primary-container); color: var(--color-on-primary); }
.btn--primary:hover { background-color: var(--color-primary-fixed-dim); }
.btn--ghost {
    background-color: var(--color-surface-container);
    color: var(--color-on-surface-variant);
    border-width: 1px;
    border-color: var(--color-outline-variant);
}
.btn--ghost:hover { background-color: var(--color-surface-container-high); }
.btn:disabled { opacity: 0.35; }

.save-hint {
    font-size: 10px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    color: var(--color-on-surface-variant);
    margin-top: 4px;
}

/* ---------- New Game confirmation ---------- */
.confirm-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.7);
}
.confirm-card {
    width: 440px;
    max-width: 90%;
    padding: 24px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--color-outline-variant);
    background-color: var(--color-surface-container);
}
.confirm-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--color-primary);
    margin-bottom: 8px;
}
.confirm-body {
    font-size: 12px;
    white-space: normal;
    color: var(--color-on-surface-variant);
    margin-bottom: 20px;
}

.hidden { display: none; }

/* Sora (Assets/Fonts/Sora); inherited by everything under the root. */
.title-root { -unity-font-definition: url("/Assets/Fonts/Sora/Sora-Regular.ttf"); }
