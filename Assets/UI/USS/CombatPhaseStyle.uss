.combat-screen {
    flex-grow: 1;
    background-color: rgba(26, 38, 52, 0);
    padding: 16px;
    color: #e0fbff;
}

.resource-bar {
    min-height: 64px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 8px 16px;
    background-color: rgba(26, 38, 52, 0.82);
    border-bottom-width: 2px;
    border-bottom-color: #00f2ff;
}

.resource-heading { min-width: 190px; }
.eyebrow, .resource-label, .panel-hint, .battlefield-label {
    font-size: 9px;
    color: #a9c4d0;
    letter-spacing: 1px;
}
.location-name { font-size: 19px; -unity-font-style: bold; color: #e0fbff; }
.resource-value { font-size: 17px; -unity-font-style: bold; color: #e0fbff; transition-property: color, scale; transition-duration: 0.35s; transform-origin: left center; }
.resource-value-positive { color: #8db58c; }
.resource-value-food { color: #d4a359; }
.resource-value-materials { color: #e09a55; }
.round-value { font-size: 26px; -unity-font-style: bold; color: #00f2ff; }

/* Top HUD blocks: icon + label/value, separated by thin dividers. Set .hud-icon background-image later. */
.hud-block { flex-direction: row; align-items: center; padding-left: 14px; padding-right: 14px; }
.hud-icon-wrap { width: 34px; height: 34px; margin-right: 10px; }
.hud-icon {
    position: absolute; left: 4px; top: 4px; right: 4px; bottom: 4px;
    background-color: rgba(160, 200, 220, 0.10);
    border-radius: 6px;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale;
    transition-duration: 0.18s;
}
.hud-icon--hero { background-color: rgba(0, 242, 255, 0.14); }
.hud-icon--villager { background-color: rgba(224, 251, 255, 0.14); }
.hud-icon--saveable { background-color: rgba(141, 181, 140, 0.18); }
.hud-icon--food { background-color: rgba(212, 163, 89, 0.18); }
.hud-icon--materials { background-color: rgba(125, 65, 0, 0.35); }
.hud-icon--gain { scale: 1.15 1.15; }

.hud-glow {
    position: absolute; left: -14px; top: -14px; right: -14px; bottom: -14px;
    border-radius: 24px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.5s;
}
.hud-glow--hero { background-color: rgba(0, 242, 255, 0.25); }
.hud-glow--villager { background-color: rgba(224, 251, 255, 0.2); }
.hud-glow--saveable { background-color: rgba(141, 181, 140, 0.3); }
.hud-glow--food { background-color: rgba(212, 163, 89, 0.55); }
.hud-glow--materials { background-color: rgba(214, 120, 30, 0.55); }
.hud-glow--active { opacity: 1; transition-duration: 0.08s; }

.hud-text-col { justify-content: center; }
.hud-separator { width: 1px; height: 30px; margin-left: 20px; background-color: #35506a; }
.hud-block--round { padding-left: 22px; }
.hud-block--round .hud-text-col { align-items: center; }

.value-gain { color: #ffffff; scale: 1.25 1.25; }

/* Floating "+N" that rises off a block when food/materials are gained. */
.gain-float {
    position: absolute;
    left: 48px; top: 2px;
    font-size: 14px; -unity-font-style: bold;
    opacity: 1;
    transition-property: translate, opacity;
    transition-duration: 0.9s;
    transition-timing-function: ease-out;
}
.gain-float--food { color: #f0c27a; }
.gain-float--materials { color: #f09a4a; }
.gain-float--rise { translate: 0 -24px; opacity: 0; }

.play-area { flex-grow: 1; flex-direction: row; margin-top: 14px; margin-bottom: 14px; background-color: rgba(26, 38, 52, 0); }
.unit-roster { width: 272px; padding: 14px; background-color: rgba(17, 21, 26, 0.82); border-width: 1px; border-color: #2a3038; }
.panel-heading, .action-heading { flex-direction: row; justify-content: space-between; align-items: center; }
.panel-title { font-size: 12px; -unity-font-style: bold; color: #e0fbff; letter-spacing: 1px; }
.unit-list { flex-grow: 1; margin-top: 12px; }
.unit-card { flex-direction: row; align-items: center; padding: 10px; margin-bottom: 8px; background-color: rgba(25, 30, 36, 0.72); border-width: 1px; border-color: #2a3038; border-radius: 3px; }
.unit-card-selected { border-left-width: 3px; border-left-color: #00f2ff; background-color: rgba(26, 38, 52, 0.78); }
.unit-card-exhausted { opacity: 0.48; }
.unit-avatar { width: 36px; height: 36px; margin-right: 10px; justify-content: center; align-items: center; border-width: 1px; border-radius: 2px; }
.avatar-vance { background-color: #2c4057; border-color: #00f2ff; }
.avatar-ghost { background-color: #293b42; border-color: #6d9a9a; }
.avatar-bulwark { background-color: #34302b; border-color: #777064; }
.avatar-letter { font-size: 17px; -unity-font-style: bold; color: #e0fbff; }
.unit-copy { flex-grow: 1; }
.unit-name { font-size: 12px; -unity-font-style: bold; color: #e0fbff; }
.unit-role, .unit-meta { font-size: 9px; color: #a9c4d0; }
.health-track { height: 5px; margin-top: 7px; margin-bottom: 4px; background-color: #0b0d10; }
.health-fill { height: 100%; background-color: #5fdc9a; }
.health-fill-low { background-color: #d4a359; }
.health-fill-dim { background-color: #59616a; }

.battlefield-panel { flex-grow: 1; margin-left: 14px; justify-content: center; align-items: center; background-color: rgba(15, 20, 24, 0); border-width: 1px; border-color: rgba(42, 48, 56, 0.45); }
.battlefield-label { color: #00f2ff; }
.battlefield-hint { margin-top: 8px; font-size: 11px; color: #59616a; letter-spacing: 1px; }

.action-bar { padding: 12px 14px; background-color: rgba(26, 38, 52, 0.78); border-top-width: 1px; border-top-color: #35506a; }
.turn-label { font-size: 10px; color: #00f2ff; -unity-font-style: bold; }
.action-buttons { flex-direction: row; margin-top: 10px; }
.action-button, .end-turn-button { flex-grow: 1; height: 42px; margin-right: 8px; border-width: 1px; border-color: #4a525d; border-radius: 2px; background-color: #20262d; color: #e0fbff; font-size: 11px; -unity-font-style: bold; letter-spacing: 1px; }
.action-button:hover { background-color: #35506a; border-color: #a9c4d0; }
.action-button-primary { background-color: #00f2ff; border-color: #00f2ff; color: #1a2634; }
.action-button-primary:hover { background-color: #74f5ff; }
.action-button-spell { border-color: #6d9a9a; color: #9dc4c1; }
.end-turn-button { flex-grow: 0; width: 110px; margin-right: 0; background-color: #35506a; border-color: #a9c4d0; color: #e0fbff; }

/* Sora (Assets/Fonts/Sora); inherited by everything under the root. */
.combat-screen { -unity-font-definition: url("/Assets/Fonts/Sora/Sora-Regular.ttf"); }
