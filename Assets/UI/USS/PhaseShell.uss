/* PhaseShell.uss
   Owns everything shared across tabs: color tokens, typography utility
   classes (label-caps, text-muted, stat-value, row/row--*, etc.), and the
   header/content-slot/footer chrome itself. DecisionContent.uss depends on
   these being loaded - it only adds Decision-specific component classes
   (panels, directive cards, forecast grid...). Roster's classes still live
   in MapPhaseStyle.uss, referenced separately from PhaseShell.uxml.

   Requires Unity 2022.2+ for USS custom properties (--x). On older
   versions, find/replace var(--token) with its literal hex value below.
*/

.phase-root {
    --color-surface: #1a2634;
    --color-surface-container-low: #1f2e3f;
    --color-surface-container: #243447;
    --color-surface-container-high: #2c4057;
    --color-surface-container-highest: #35506a;

    --color-primary: #e0fbff;
    --color-primary-fixed: #74F5FF;
    --color-primary-fixed-dim: #00dbe7;
    --color-primary-container: #00F2FF;
    --color-on-primary: #00363A;

    --color-on-surface: #e0fbff;
    --color-on-surface-variant: #a9c4d0;
    --color-outline: #6f8ca0;
    --color-outline-variant: #35506a;

    --color-error: #FFB4AB;
    --color-error-container: #93000A;
    --color-on-error-container: #FFDAD6;

    --color-secondary-fixed: #CDE7EB;
    --color-secondary-container: #2c4a56;
    --color-on-secondary-container: #a9c4d0;

    flex-grow: 1;
    background-color: var(--color-surface);
    color: var(--color-on-surface);
}

/* Overrides MapPhaseStyle.uss's .screen-root (padding: 16px; justify-content:
   space-between;), which was sized for the old layout where a screen's
   header/list/footer were direct children of screen-root. Now screen-root
   wraps stats-header + content-slot + bottom-nav-bar instead, and each of
   those owns its own inset (stats-header's margin, each content pane's own
   padding) - so the padding here would just double up with theirs and knock
   Roster and Decision out of alignment with each other. Zeroed out so there
   is exactly one place (20px, matching stats-header's side margin below)
   that defines the shared horizontal inset. */
.screen-root { flex-grow: 1; padding: 0; justify-content: flex-start; flex-direction: row; }

/* Landscape layout: fixed-width left sidebar (stats, action, nav) with the
   swappable content-slot filling the rest. Sidebar scrolls if a short screen
   can't fit it. */
.shell-sidebar {
    width: 320px;
    flex-shrink: 0;
    flex-direction: column;
    justify-content: space-between;
    background-color: var(--color-surface-container-low);
    border-right-width: 1px;
    border-right-color: rgba(0, 242, 255, 0.1);
}
.shell-sidebar .stats-header { margin: 12px; }
.shell-sidebar .stats-header__grid { flex-direction: row; flex-wrap: wrap; margin-right: 0; }
.shell-sidebar .stats-header__cell {
    width: 47%;
    flex-grow: 0;
    flex-basis: auto;
    margin-right: 6px;
    margin-bottom: 6px;
    min-height: 56px;
}
.shell-sidebar .action-container { padding: 8px 12px; }
.shell-sidebar .bottom-nav-bar {
    flex-direction: column;
    height: auto;
    margin-top: 0;
    padding-top: 0;
    justify-content: flex-start;
}
.shell-sidebar .nav-button { height: 44px; flex-grow: 0; flex-shrink: 0; font-size: 12px; }
.screen-content { flex-grow: 1; }

/* action-container (selection-counter + engage-button) is defined in
   MapPhaseStyle.uss and, like stats-header/bottom-nav-bar, sits outside
   content-slot as fixed shell chrome - pin it too so it can't be squeezed. */
.action-container { flex-shrink: 0; }

/* ---------- Shared typography utilities (used by every tab's content) ---------- */
.label-caps {
    font-size: 10px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: var(--color-on-surface);
}
.body-text { font-size: 12px; white-space: normal; }
.headline { font-size: 24px; -unity-font-style: bold; color: var(--color-primary); margin-top: 2px; }
.stat-value { font-size: 13px; -unity-font-style: bold; color: var(--color-on-surface); }
.stat-value--md { font-size: 14px; }
.stat-suffix { font-size: 10px; color: var(--color-outline); margin-left: 2px; }
.stat-text { font-size: 12px; -unity-font-style: bold; }

.text-muted { color: var(--color-on-surface-variant); }
.text-bold { -unity-font-style: bold; }
.text-positive { color: var(--color-primary-fixed); }
.text-negative { color: var(--color-error); }
.text-primary { color: var(--color-primary); }
.text-primary-fixed { color: var(--color-primary-fixed); }
.text-primary-fixed-dim { color: var(--color-primary-fixed-dim); }
.text-primary-container { color: var(--color-primary-container); }

.row { flex-direction: row; align-items: center; }
.row--space-between { justify-content: space-between; }
.row--baseline { align-items: flex-end; }
.row--gap-sm > * { margin-right: 8px; }
.row--gap-xs > * { margin-right: 4px; }

.chip {
    font-size: 9px;
    color: var(--color-on-surface-variant);
    background-color: var(--color-surface-container);
    border-radius: 4px;
    padding: 2px 8px;
}
.chip--muted { color: var(--color-outline); }

/* ---------- Shared stats header (replaces the old per-screen title+timer header) ---------- */
.stats-header {
    background-color: var(--color-surface-container-low);
    border-radius: 8px;
    padding: 12px;
    margin: 12px 20px 0 20px;
    /* Pinned to its content size - without this, a tall tab's content-slot
       (see below) can pressure screen-root's flex layout into shrinking this
       instead of just scrolling the overflow, since Yoga has no default
       flex-shrink weighting toward flex-grow:0 siblings. */
    flex-shrink: 0;
}
.stats-header__row { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 8px; }

/* Save Game - small icon-only button pinned to the header row's right edge. */
.save-button {
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border-width: 1px;
    border-radius: 6px;
    border-color: var(--color-outline-variant);
    background-color: var(--color-surface-container-high);
    align-items: center;
    justify-content: center;
}
.save-button:hover { background-color: var(--color-surface-container-highest); border-color: var(--color-primary-fixed-dim); }
.save-button:active { background-color: var(--color-secondary-container); }
.save-button__icon {
    width: 26px;
    height: 26px;
    background-image: url("project://database/Assets/UI/Icons/Clean%20Vector%20Icons/T_8_tab_.png?fileID=21300000&guid=64df4b6d7138b2c489e0b9a444cfa521&type=3#T_8_tab_");
    -unity-background-image-tint-color: var(--color-primary-fixed-dim);
}
.save-button:hover .save-button__icon { -unity-background-image-tint-color: var(--color-primary); }
.stats-header__grid { flex-direction: row; margin-right: -6px; } /* cancels last cell trailing margin (USS has no :last-child) */
.stats-header__cell {
    flex-grow: 1;
    flex-basis: 0;
    justify-content: space-between;
    background-color: var(--color-surface-container-high);
    border-radius: 4px;
    padding: 8px;
    margin-right: 6px;
    min-height: 64px;
}

/* ---------- Swappable content area ---------- */
.content-slot { flex-grow: 1; }

/* ---------- Shared bottom nav ---------- */
.bottom-nav-bar {
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    height: 80px;
    flex-shrink: 0;
    background-color: rgba(26, 38, 52, 0.92);
    border-top-width: 1px;
    border-top-color: rgba(0, 242, 255, 0.1);
}
.nav-button {
    flex-grow: 1;
    height: 100%;
    -unity-text-align: middle-center;
    background-color: transparent;
    border-width: 0;
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: var(--color-on-surface-variant);
}
.nav-button-active { color: var(--color-primary-fixed); }
.nav-button:disabled { opacity: 0.4; }

/* ---------- Placeholder tabs (Campaign Map, Store) ---------- */
.placeholder-content {
    align-items: center;
    justify-content: center;
}
.placeholder-title {
    font-size: 16px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: var(--color-on-surface-variant);
    margin-bottom: 6px;
}
.placeholder-body { font-size: 12px; color: var(--color-outline); }

/* ---------- Readiness checklist (sidebar, above March to War) ---------- */
.readiness-checklist { margin-bottom: 8px; }
.readiness-title { margin-bottom: 4px; }
.readiness-row {
    font-size: 12px;
    color: var(--color-error);
    padding: 3px 0;
}
.readiness-row--done { color: var(--color-primary-fixed); }
.readiness-row--extra { display: none; }
.readiness-row--extra.readiness-row--active { display: flex; }

/* Sora (Assets/Fonts/Sora); inherited by everything under the root. */
.phase-root { -unity-font-definition: url("/Assets/Fonts/Sora/Sora-Regular.ttf"); }
