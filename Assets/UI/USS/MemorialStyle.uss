.memorial-content {
    flex-grow: 1;
    padding: 16px;
}

.memorial-title {
    font-size: 28px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    color: rgb(150, 156, 163);
}

.memorial-subtitle {
    font-size: 13px;
    margin-bottom: 12px;
    color: rgb(89, 97, 105);
}

.memorial-empty {
    font-size: 16px;
    margin-top: 24px;
    -unity-text-align: upper-center;
    color: rgb(89, 97, 105);
}

.memorial-list {
    flex-grow: 1;
}

.memorial-row {
    padding: 10px 14px;
    margin-bottom: 8px;
    background-color: rgba(20, 24, 30, 0.85);
    border-left-width: 4px;
    border-left-color: rgb(89, 97, 105);
    border-radius: 4px;
}

.memorial-row-name {
    font-size: 18px;
    -unity-font-style: bold;
}

.memorial-row-class {
    font-size: 13px;
    color: rgb(170, 176, 183);
}

.memorial-row-when {
    font-size: 12px;
    margin-top: 2px;
    color: rgb(110, 118, 126);
}

/* ---------- Header / summary / filters ---------- */

.memorial-header-block {
    margin-bottom: 10px;
}

.memorial-summary {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 10px;
}

.memorial-summary-cell {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 110px;
    margin-right: 6px;
    margin-bottom: 6px;
    padding: 8px 10px;
    background-color: rgba(20, 24, 30, 0.85);
    border-width: 1px;
    border-color: rgba(89, 97, 105, 0.5);
}

.memorial-summary-value {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(170, 176, 183);
}

.memorial-summary-label {
    font-size: 9px;
    letter-spacing: 1px;
    color: rgb(110, 118, 126);
}

.memorial-filters {
    flex-direction: row;
    margin-bottom: 10px;
}

.memorial-filter {
    margin: 0 6px 0 0;
    padding: 4px 14px;
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: rgb(110, 118, 126);
    background-color: rgba(20, 24, 30, 0.85);
    border-width: 1px;
    border-color: rgba(89, 97, 105, 0.5);
    border-radius: 0;
}

.memorial-filter--active {
    color: rgb(190, 196, 203);
    border-color: rgb(150, 156, 163);
    background-color: rgba(60, 66, 74, 0.8);
}

/* ---------- Card grid ---------- */

.memorial-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.memorial-slot {
    width: 360px;
    margin: 0 10px 10px 0;
}

/* ---------- Greyed-out fallen unit card ---------- */

.memorial-card {
    flex-direction: row;
    padding: 10px;
    background-color: rgb(30, 33, 38);
    border-width: 1px;
    border-color: rgb(62, 67, 74);
    border-left-width: 4px;
    border-left-color: rgb(89, 97, 105);
    opacity: 0.88;
}

.memorial-portrait-column {
    width: 92px;
    flex-shrink: 0;
    margin-right: 12px;
}

.memorial-portrait-frame {
    position: relative;
    width: 92px;
    height: 108px;
    overflow: hidden;
    background-color: rgb(40, 43, 48);
    border-width: 1px;
    border-color: rgb(75, 80, 88);
}

/* Drained portrait: tint to grey, then a dark wash on top. */
.memorial-portrait {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgb(110, 110, 110);
}

.memorial-portrait-shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(10, 12, 16, 0.55);
}

.memorial-cross {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    font-size: 34px;
    color: rgba(190, 196, 203, 0.55);
}

.memorial-level {
    position: absolute;
    left: 5px;
    bottom: 5px;
    padding: 2px 5px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(150, 156, 163);
    background-color: rgba(8, 10, 14, 0.85);
}

.memorial-rarity {
    margin-top: 6px;
    font-size: 8px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(110, 118, 126);
}

.memorial-info {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
}

.memorial-header {
    padding-bottom: 6px;
    margin-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(89, 97, 105, 0.5);
}

.memorial-name {
    font-size: 16px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: rgb(150, 156, 163);
}

.memorial-class {
    margin-top: 2px;
    font-size: 9px;
    letter-spacing: 1px;
    color: rgb(100, 108, 116);
}

.memorial-cause-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.memorial-cause {
    font-size: 9px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: rgb(150, 100, 100);
}

.memorial-cycle {
    font-size: 9px;
    letter-spacing: 1px;
    color: rgb(100, 108, 116);
}

.memorial-detail {
    margin-top: 2px;
    font-size: 11px;
    -unity-font-style: italic;
    white-space: normal;
    color: rgb(110, 118, 126);
}

.memorial-hp {
    margin-top: auto;
    padding-top: 8px;
}

.memorial-hp-title {
    font-size: 8px;
    letter-spacing: 1px;
    color: rgb(100, 108, 116);
}

.memorial-hp-bar {
    height: 8px;
    margin: 3px 0;
    background-color: rgb(24, 27, 31);
    border-width: 1px;
    border-color: rgb(55, 60, 66);
}

.memorial-hp-fill {
    width: 0;
    height: 100%;
    background-color: rgb(110, 118, 126);
}

.memorial-hp-value {
    font-size: 10px;
    color: rgb(110, 118, 126);
}

/* A faint tier-coloured edge so rarity is still legible on a grey card. */
.memorial-rarity-common .memorial-card { border-left-color: rgb(110, 114, 120); }
.memorial-rarity-uncommon .memorial-card { border-left-color: rgb(70, 112, 76); }
.memorial-rarity-rare .memorial-card { border-left-color: rgb(58, 92, 140); }
.memorial-rarity-epic .memorial-card { border-left-color: rgb(110, 70, 146); }
.memorial-rarity-legendary .memorial-card { border-left-color: rgb(150, 98, 40); }
.memorial-rarity-mythical .memorial-card { border-left-color: rgb(160, 138, 60); }
