/* CampaignMapContent.uss
   Campaign-Map-tab-specific component styles only. Typography utilities
   (label-caps, text-muted, row/row--*...), the stats header and bottom nav
   all live in PhaseShell.uss; .panel, .directive-card, .icon-badge,
   .card-info-grid, .info-line, .tag etc. are reused from DecisionContent.uss
   rather than redefined here - both are loaded ahead of this file (see
   CampaignMapContent.uxml's <Style> order).

   Icon inventory - ".icon-stay-put" / ".icon-travel" / ".icon-rest" are empty
   placeholders, same convention as DecisionContent.uss: assign a sprite/
   texture per class below (background-image) once art exists.
*/

/* ---------- Hero (the long ships background image) ---------- */
.campaign-map-hero { padding: 0; overflow: hidden; }
.campaign-map-hero__image {
    height: 180px;
    background-color: var(--color-surface-container-highest);
    -unity-background-scale-mode: scale-and-crop;
}
.campaign-map-hero__caption { padding: 10px 14px; }

/* ---------- Course options (Stay Put / Travel / Rest) ---------- */
/* These reuse .panel + .directive-card from DecisionContent.uss for the card
   shell, then layer ui:Button's clickable/selectable behavior on top - reset
   Unity's default button chrome (border, centered text, base background) so
   the card renders identically to the other tabs' plain-VisualElement cards. */
.campaign-option {
    border-width: 0;
    padding: 14px;
    align-items: stretch;
    -unity-text-align: upper-left;
}
.campaign-option:hover { background-color: var(--color-surface-container); }
.campaign-option--selected {
    border-width: 2px;
    border-color: var(--color-primary-fixed);
    background-color: var(--color-surface-container);
}
.campaign-option__badge { display: none; }
.campaign-option--selected .campaign-option__badge { display: flex; }
